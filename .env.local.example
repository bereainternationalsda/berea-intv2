# Copy this file to .env.local and fill in your own Sanity project details.
# Get these after running: npx sanity login && npx sanity init

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Only needed to run the seed script (scripts/seed.mjs).
# Create one at https://sanity.io/manage -> your project -> API -> Tokens
# (needs "Editor" permissions).
SANITY_API_WRITE_TOKEN=
